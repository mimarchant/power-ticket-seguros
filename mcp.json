{
  "mcpServers": {
    "atlassian": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote@0.15.2",
        "https://mcp.atlassian.com/v1/mcp/authv2"
      ],
      "env": {
        "npm_config_registry": "https://registry.npmjs.org/"
      },
      "disabled": false,
      "autoApprove": [
        "getJiraIssue",
        "searchJiraIssuesUsingJql",
        "lookupJiraAccountId"
      ]
    },
    "bitbucket": {
      "command": "npx",
      "args": [
        "-y",
        "bitbucket-mcp@latest"
      ],
      "env": {
        "npm_config_registry": "https://registry.npmjs.org/",
        "BITBUCKET_URL": "https://api.bitbucket.org/2.0",
        "BITBUCKET_WORKSPACE": "cnsvbucket",
        "BITBUCKET_USERNAME": "TU_CORREO@consorcio.cl",
        "BITBUCKET_PASSWORD": "TU_API_TOKEN_CON_SCOPES"
      },
      "disabled": false,
      "disabledTools": [
        "mergePullRequest",
        "approvePullRequest",
        "unapprovePullRequest",
        "declinePullRequest"
      ]
    }
  }
}